# Ovum Hospitals Theme & Brand Configuration
VITE_HOSPITAL_NAME="Ovum Woman & Child Speciality Hospitals"
VITE_WHATSAPP_NUMBER="919686909236"
VITE_THEME_PRIMARY="#00897B"
VITE_THEME_PRIMARY_DARK="#005B52"
VITE_THEME_PRIMARY_LIGHT="#E0F2F1"
VITE_THEME_ACCENT="#E91E63"
VITE_THEME_GRADIENT_START="#00695C"
VITE_THEME_GRADIENT_END="#00897B"

# Where the app is served from, on the same domain as the Patient 360 portal (so the portal's session cookie works).
# Dev: leave empty. Production build: VITE_BASE=/journey/
VITE_BASE=
# Dev only: the local Patient 360 API that /api is proxied to.
API_ORIGIN=http://localhost:3000
# The patient portal, where consent is managed (the tracker links to its profile page). Defaults to production.
VITE_PORTAL_URL=https://my.ovumhospitals.com
